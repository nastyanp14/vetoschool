# --- Frontend (safe to ship in the browser bundle) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Server side only: never prefix with VITE_, never commit real values ---
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PORTAL_CONFIGURATION_ID=
ELEVENLABS_API_KEY=
# SendPulse is the email transport for auth + transactional queues
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_FROM_EMAIL=noreply@notify.vetoschool.eu
SENDPULSE_FROM_NAME=Vetoschool
SENDPULSE_EMAIL_ENDPOINT=https://api.sendpulse.com/smtp/emails
# Supabase Auth "Send Email" hook secret (format: v1,whsec_...)
SEND_EMAIL_HOOK_SECRET=
# Optional: authorizes GET/POST /auth-email-hook/preview
AUTH_EMAIL_PREVIEW_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CRON_SECRET=
APP_URL=http://127.0.0.1:8080
SUCCESS_URL=http://127.0.0.1:8080/payment/success
CANCEL_URL=http://127.0.0.1:8080/payment/cancel

# --- Storage migration script (scripts/migrate-storage.mjs), local use only ---
OLD_SUPABASE_URL=
# Lovable Cloud source has no accessible service role key -> read it with an admin session:
OLD_ANON_KEY=
OLD_ADMIN_EMAIL=
OLD_ADMIN_PASSWORD=
# Optional alternative to the admin session, if a source service role key is ever available:
OLD_SERVICE_ROLE_KEY=
NEW_SUPABASE_URL=
NEW_SERVICE_ROLE_KEY=
